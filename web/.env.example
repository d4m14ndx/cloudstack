# CloudStack Web — environment variables
# Copy to .env.local for development; populate per-deployment for production.

# Public app environment label (shown in sidebar pill — "local" / "dev" / "qa" / "prod").
# This is a NEXT_PUBLIC_ variable and is exposed to the browser; do not rely on
# it for security-sensitive gating. The dev-session escape (see BFF_DEV_SESSION
# below) is always blocked at runtime when NODE_ENV=production regardless of
# this value.
NEXT_PUBLIC_APP_ENV=local

# === Phase 5b — Auth.js / BFF local development ===
# Development can run without these values; the app falls back to the Phase 5a
# mock current-user bridge when no provider is configured. Production runtime
# requires NEXTAUTH_URL, NEXTAUTH_SECRET, Authentik, and Redis values.
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace-me-with-output-of-openssl-rand-hex-32

# === DEV-ONLY: anonymous CloudStack session escape ===
# When set, ANY anonymous request to /api/cs/* is proxied to CloudStack using
# a hardcoded ROOT session. Used by the local mock harness so UI work can
# proceed without a live OIDC provider. NEVER enable this in production —
# the runtime check in lib/bff/config.ts ignores this flag when
# NODE_ENV=production, but you should also leave it off in any deployed
# environment as a defence-in-depth measure.
# BFF_DEV_SESSION=true
# BFF_DEV_USERNAME=dev
# BFF_DEV_DOMAIN=ROOT
# BFF_DEV_SESSIONKEY=replace-with-a-real-cloudstack-sessionkey

# === Authentik OIDC ===
# Use http://authentik.localhost:9000/application/o/cloudstack/ when running
# the web service in docker compose with the auth profile.
# Issuer should include the Authentik application slug without a trailing slash.
# AUTHENTIK_ISSUER=http://localhost:9000/application/o/cloudstack
# AUTHENTIK_CLIENT_ID=cloudstack-bff
# AUTHENTIK_CLIENT_SECRET=replace-me-with-authentik-provider-secret

# === Microsoft Entra ID OIDC (optional secondary provider) ===
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0/

# === Redis session store ===
# Use redis://redis:6379 inside docker compose; use redis://localhost:6379
# when running Next.js directly on the host against the compose Redis service.
# REDIS_URL=redis://localhost:6379

# === CloudStack management server ===
# Use http://cloudstack:8080 inside docker compose; use http://localhost:8080
# when running Next.js directly on the host.
# CS_URL=http://localhost:8080
# CS_SERVICE_APIKEY=replace-me-with-local-service-account-api-key
# CS_SERVICE_SECRETKEY=replace-me-with-local-service-account-secret-key

# === Session lifetimes ===
# BFF_SESSION_TTL_SECONDS=28800
# CS_SESSION_REFRESH_MARGIN_SECONDS=120

# === Authentik compose profile only ===
# AUTHENTIK_SECRET_KEY=replace-me-with-local-dev-only-random-secret
# AUTHENTIK_POSTGRES_PASSWORD=authentik
