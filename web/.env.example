# CloudStack Web — environment variables
# Copy to .env.local for development; populate per-deployment for production.

# Public app environment label (shown in sidebar pill — "dev" / "qa" / "prod")
NEXT_PUBLIC_APP_ENV=dev

# === Phase 5b — Auth.js / BFF local development ===
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace-me-with-output-of-openssl-rand-hex-32

# === Authentik OIDC ===
# Use http://authentik.localhost:9000/application/o/cloudstack/ when running
# the web service in docker compose with the auth profile.
# AUTHENTIK_ISSUER=http://localhost:9000/application/o/cloudstack/
# AUTHENTIK_CLIENT_ID=cloudstack-bff
# AUTHENTIK_CLIENT_SECRET=replace-me-with-authentik-provider-secret

# === Redis session store ===
# Use redis://redis:6379 inside docker compose; use redis://localhost:6379
# when running Next.js directly on the host against the compose Redis service.
# REDIS_URL=redis://localhost:6379

# === CloudStack management server ===
# Use http://cloudstack:8080 inside docker compose; use http://localhost:8080
# when running Next.js directly on the host.
# CS_URL=http://localhost:8080
# CS_SERVICE_APIKEY=replace-me-with-local-service-account-api-key
# CS_SERVICE_SECRETKEY=replace-me-with-local-service-account-secret-key

# === Session lifetimes ===
# BFF_SESSION_TTL_SECONDS=28800
# CS_SESSION_REFRESH_MARGIN_SECONDS=120

# === Authentik compose profile only ===
# AUTHENTIK_SECRET_KEY=replace-me-with-local-dev-only-random-secret
# AUTHENTIK_POSTGRES_PASSWORD=authentik
